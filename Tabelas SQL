-----------------------------------------------------------------------------------------
ACESSOS E PESSOAS
-----------------------------------------------------------------------------------------
CREATE TABLE cliente(
id_cliente SERIAL PRIMARY KEY,
cpf VARCHAR (11) NOT NULL UNIQUE,
nome_completo VARCHAR (150) NOT NULL,
email VARCHAR (150),
telefone VARCHAR (20) NOT NULL,
endereco VARCHAR (255) NOT NULL
);
CREATE TABLE funcionario(
id_funcionario SERIAL PRIMARY KEY,
cpf VARCHAR (11) UNIQUE NOT NULL,
nome_completo VARCHAR (150) NOT NULL,
email VARCHAR (150),
cargo VARCHAR (80) NOT NULL,
salario NUMERIC (10,2) NOT NULL CHECK (salario > 0),
matricula VARCHAR (20) UNIQUE
);
CREATE TABLE role(
id_role SERIAL PRIMARY KEY,
nome VARCHAR (50) NOT NULL UNIQUE,
descricao VARCHAR (255)
);
CREATE TABLE usuario(
id_usuario SERIAL PRIMARY KEY,
id_role INTEGER NOT NULL REFERENCES role (id_role),
id_funcionario INTEGER REFERENCES funcionario (id_funcionario),
nome_completo VARCHAR (150) NOT NULL,
login VARCHAR (50) NOT NULL UNIQUE,
senha_hash VARCHAR (100) NOT NULL,
ativo BOOLEAN NOT NULL DEFAULT TRUE,
data_cadastro TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE log_acesso(
id_log SERIAL PRIMARY KEY,
id_usuario INTEGER REFERENCES usuario (id_usuario),
login_informado VARCHAR (50) NOT NULL, -- saber o que o usuario está informando na caixa de texto "usuario'
data_hora TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
tipo_evento VARCHAR (20) NOT NULL CHECK (tipo_evento IN ('LOGIN', 'LOGOUT ','FALHA_LOGIN'))
);

-----------------------------------------------------------------------------------------
PRODUTOS
-----------------------------------------------------------------------------------------
CREATE TABLE fornecedor (
id_fornecedor SERIAL PRIMARY KEY,
nome_fantasia VARCHAR (150) NOT NULL,
cnpj VARCHAR (14) NOT NULL UNIQUE
);

CREATE TABLE categoria(
id_categoria SERIAL PRIMARY KEY,
nome VARCHAR (80)NOT NULL UNIQUE
);

CREATE TABLE produto (
id_produto SERIAL PRIMARY KEY,
nome VARCHAR (150) NOT NULL,
codigo_embalagem VARCHAR (50) NOT NULL UNIQUE,
id_categoria INTEGER NOT NULL REFERENCES categoria (id_categoria),
id_fornecedor INTEGER NOT NULL REFERENCES fornecedor (id_fornecedor),
valor_ultm_compra NUMERIC (10,2) CHECK (valor_ultm_compra >=0), --faze checagem do valor, ==0 em casoo de brince
observacao TEXT
);

-----------------------------------------------------------------------------------------
ESTOQUE
-----------------------------------------------------------------------------------------
CREATE TABLE estoque (
id_estoque SERIAL PRIMARY KEY,
id_produto INTEGER NOT NULL UNIQUE REFERENCES produto (id_produto),
valor_custo NUMERIC (10,2) NOT NULL CHECK (valor_custo >= 0),
valor_venda NUMERIC (10,2) NOT NULL CHECK (valor_venda > 0),
quantidade INTEGER NOT NULL DEFAULT 0 CHECK (quantidade>=0)
);

CREATE TABLE movimenta_estoque(
id_movimentacao SERIAL PRIMARY KEY,
id_produto INTEGER NOT NULL REFERENCES produto (id_produto),
tipo VARCHAR (7) NOT NULL CHECK (tipo IN ('ENTRADA', 'SAIDA')),
quantidade INTEGER NOT NULL CHECK (quantidade > 0),
motivo VARCHAR (255)
);

-----------------------------------------------------------------------------------------
VENDA
-----------------------------------------------------------------------------------------

CREATE TABLE venda (
id_venda SERIAL PRIMARY KEY,
id_cliente INTEGER NOT NULL REFERENCES cliente (id_cliente),
id_usuario INTEGER NOT NULL REFERENCES usuario (id_usuario),
data_venda TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
status VARCHAR (10) NOT NULL DEFAULT ('ABERTA') CHECK (status IN ('ABERTA', 'FINALIZADA', 'CANCELADA')),
valor_total NUMERIC (10,2) NOT NULL DEFAULT 0
);

CREATE TABLE itens_venda(
id_item SERIAL PRIMARY KEY,
id_venda INTEGER NOT NULL REFERENCES venda (id_venda),
id_produto INTEGER NOT NULL REFERENCES produto (id_produto),
quantidade INTEGER NOT NULL CHECK (quantidade > 0),
valor_unitario NUMERIC (10,2) NOT NULL CHECK (valor_unitario >=0),
subtotal NUMERIC (12,2) GENERATED ALWAYS AS (quantidade * valor_unitario) STORED
);

CREATE TABLE pagameto (
id_pagamento SERIAL PRIMARY KEY,
id_venda INTEGER NOT NULL REFERENCES venda(id_venda),
forma_pagamento VARCHAR (9) NOT NULL CHECK (forma_pagamento IN ('PIX','DEBITO','CREDITO','DINHEIRO')),
valor_pago NUMERIC (10,2) NOT NULL CHECK (valor_pago > 0),
data_pagamento TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE auditoria (
id_auditoria SERIAL PRIMARY KEY,
id_venda INTEGER NOT NULL REFERENCES venda (id_venda),
id_usuario INTEGER NOT NULL REFERENCES usuario (id_usuario),
operacao VARCHAR (12) NOT NULL CHECK (operacao IN ('INSERCAO','ALTERACAO','CANCELAMENTO')),
data_hora TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
dado_anterior JSONB,
dado_novo JSONB,
motivo VARCHAR (255),

CONSTRAINT ck_auditoria_motivo_cancelamento CHECK (operacao<> 'CANCELAMENTO' OR motivo IS NOT NULL)
);

CREATE TABLE log_operacao (
id_log SERIAL PRIMARY KEY,
id_usuario INT REFERENCES usuario(id_usuario) ON DELETE SET NULL,
operaca VARCHAR(30)  NOT NULL, -- VENDA, PERMISSAO_NEGADA, ENTRADA_ESTOQUE...
tabela_afetada VARCHAR(50),
resultado VARCHAR(20)  NOT NULL,      -- SUCESSO, ROLLBACK, NEGADO, ERRO
descrica TEXT,
data_hora TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
